# ============================================================
# NIGCOMSAT Travel Request Tool — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values:
#   cp env.example .env.local
#
# NEVER commit .env.local to the repository.
# ============================================================

# Supabase — Public (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase — Server Only (NEVER expose to client)
# Used only in src/lib/supabase/admin.ts (guarded by 'server-only' package)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Temporary sandbox machine credential for the ERP collection API.
# Production must replace this with the approved rotating credential workflow.
ERP_INTEGRATION_API_KEY=replace-with-a-long-random-sandbox-secret
# During rotation, deploy the new current key and retain the old key here until
# Business Central has switched; remove this value after the overlap window.
ERP_INTEGRATION_API_KEY_PREVIOUS=
# Enable only after 20261021030000_erp_api_rate_limit.sql is applied.
ERP_API_RATE_LIMIT_ENABLED=false
ERP_API_RATE_LIMIT_PER_MINUTE=120
